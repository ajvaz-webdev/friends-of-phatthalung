# Cloudflare static asset caching.
# Photos, videos and game art rarely change, so browsers can keep them for a
# week instead of re-checking on every visit. If you replace a file but keep
# its name, returning visitors may see the old one for up to a week; giving
# the new file a new name avoids that.

/photos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/game/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/phatthalung-map.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800

# Build files have a content hash in their names, so they can be cached for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
